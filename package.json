{
  "name": "repsil",
  "version": "0.1.0",
  "description": "Local document archive with LAN sync — Windows-native, no cloud, bilingual EN/AR",
  "main": "out/main/index.js",
  "private": true,
  "author": "Repsil",
  "scripts": {
    "dev": "node scripts/run.cjs electron-vite dev",
    "build": "node scripts/run.cjs electron-vite build",
    "preview": "node scripts/run.cjs electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-builder install-app-deps"
  },
